# Doxygen configuration for the C code of octal-explorer.
#   make doxygen        (or: doxygen Doxyfile)
# Output: doxygen/html/index.html.  Settings not listed here use Doxygen's defaults.

#---------------------------------------------------------------- project
PROJECT_NAME           = "octal-explorer"
PROJECT_BRIEF          = "Nim-sequences of octal and hexadecimal take-and-break games"
PROJECT_NUMBER         = 0.1.0
OUTPUT_DIRECTORY       = doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------- input
INPUT                  = octal.h octal_internal.h octal.c octal_output.c README.md
FILE_PATTERNS          = *.c *.h
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE = README.md
# OCTAL_NO_MAIN is left undefined, so main() and usage() are documented too
PREDEFINED             =
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

#---------------------------------------------------------------- language and extraction
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
SORT_MEMBER_DOCS       = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

#---------------------------------------------------------------- warnings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = doxygen/warnings.log

#---------------------------------------------------------------- output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = AUTO_LIGHT
SEARCHENGINE           = YES
USE_MATHJAX            = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------- graphs (needs Graphviz "dot")
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 60
